# Open Researcher Environment Variables
# Copy this file to .env.local and fill in your actual API keys

# Required: Sarvam AI API key (default model provider).
# The research agent runs on sarvam-105b through Sarvam's OpenAI-compatible
# chat completions API. Get a key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional overrides for the Sarvam provider
# SARVAM_MODEL=sarvam-105b              # or sarvam-105b-conversations
# SARVAM_BASE_URL=https://api.sarvam.ai/v1
# SARVAM_REASONING_EFFORT=medium        # low | medium | high | none

# Optional: Firecrawl API key for web search and scraping.
# If not provided, you can add it through the UI.
# Get yours at: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: Anthropic fallback. Used only when SARVAM_API_KEY is not set
# (or when LLM_PROVIDER=anthropic).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# Optional: choose the provider explicitly instead of auto-detecting it.
# LLM_PROVIDER=sarvam

# Optional: research loop tuning
# LLM_MAX_TOKENS=8192
# LLM_MAX_STEPS=12
# LLM_TIMEOUT_MS=180000

# Optional: Cartesia voice.
# With a key set, answers can be read aloud (Sonic) and questions can be
# dictated with the microphone (Ink). Leave it blank to hide the voice UI.
# Get a key at: https://play.cartesia.ai/keys
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=                    # defaults to the first voice on the account
# CARTESIA_TTS_MODEL=sonic-3.6
# CARTESIA_STT_MODEL=ink-whisper
# CARTESIA_VERSION=2026-08-14
